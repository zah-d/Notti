<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <ImageView
        android:id="@+id/circularIcon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@drawable/circle_background"
        android:src="@mipmap/ic_launcher_n7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="5dp"
         />

    <TextView
        android:id="@+id/noteTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/circularIcon"
        app:layout_constraintTop_toTopOf="@id/circularIcon"
        android:layout_marginStart="10dp"/>

    <TextView
        android:id="@+id/noteLastMessageDateTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/noteTitle"/>

    <TextView
        android:id="@+id/noteLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintStart_toStartOf="@id/circularIcon"
        app:layout_constraintTop_toBottomOf="@id/circularIcon"
        android:layout_marginTop="10dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>