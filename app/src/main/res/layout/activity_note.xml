<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/note_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_navigation"
        android:elevation="4dp"
        android:text=""
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <!-- Custom Title TextView -->
        <TextView
            android:id="@+id/note_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="@style/NoteToolbarTitleText"
            android:textStyle="normal"
            android:layout_gravity="center" />

        <!-- User Image (Now Works as Menu Button) -->
        <FrameLayout
            android:id="@+id/note_user_menu_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginTop="@dimen/activity_horizontal_margin">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/note_img_user"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:src="@drawable/zah_user"
                app:strokeWidth="1dp"
                app:strokeColor="@color/background_navigation"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                android:contentDescription="User Image"/>


            <!-- Online Status Indicator -->
            <!--View
                android:id="@+id/online_status"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_border"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="4dp"/-->
        </FrameLayout>

        <!-- Search EditText -->
        <EditText
            android:id="@+id/note_search_bar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/background_navigation"
            android:hint="חיפוש..."
            android:padding="8dp"
            android:layout_gravity="end"
            android:textColor="@android:color/white"
            android:textColorHint="@android:color/darker_gray"
            android:visibility="gone"/>

        <!-- Search Icon -->
        <ImageView
            android:id="@+id/note_search_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@android:drawable/ic_menu_search"
            android:layout_marginStart="8dp"
            android:layout_gravity="end"
            app:tint="@android:color/white" />

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/note_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/note_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:background="@color/background_navigation"
            android:overScrollMode="never"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/background_navigation"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/attachButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Attach"
                android:background="@color/background_navigation"
                android:src="@android:drawable/ic_menu_camera" />

            <EditText
                android:id="@+id/inputMessage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/message_input_bg"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:padding="12dp"
                android:paddingStart="50dp"
                android:paddingEnd="5dp"
                android:gravity="center_vertical"
                android:imeOptions="actionSend"
                android:maxLines="100"
                android:inputType="textMultiLine"
                android:hint="הודעה"/>

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_send"
                android:background="@color/background_navigation"
                android:contentDescription="Send"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>